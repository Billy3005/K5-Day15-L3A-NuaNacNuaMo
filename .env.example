# Chép file này thành .env rồi điền (Windows: copy .env.example .env · macOS/Linux: cp .env.example .env).
# KHÔNG commit .env (đã có trong .gitignore). Không dán key vào code, slide, ảnh chụp màn hình.
# BTC KHÔNG cấp API key: dùng gói miễn phí hoặc tài khoản của nhóm (xem docs/connect-model.md).
# MODEL_PROVIDER: để trống hoặc fake = chế độ giả (chưa gọi model) · openai (đã nối) …
# MODEL_NAME: mã gọi API của model, đúng như tài liệu nhà cung cấp, vd gpt-5.4-nano.
MODEL_PROVIDER=
MODEL_NAME=
API_KEY=

# Tìm kiếm web (AN-01). mock = đọc data/mock_resources.json (mặc định) · anthropic = Claude web_search.
SEARCH_PROVIDER=mock
# Key Anthropic, chỉ dùng cho tìm kiếm. Mỗi lượt tìm tính $10 / 1000 lượt cộng tiền token.
SEARCH_API_KEY=
# Model chạy web_search. Mặc định claude-opus-5-5; claude-haiku-5-5 rẻ hơn nhiều (dùng bản web_search cơ bản).
SEARCH_MODEL=claude-opus-5-5
# Số lượt tìm tối đa trong một lần gọi, và mức effort (low / medium / high).
SEARCH_MAX_USES=3
SEARCH_EFFORT=low
